[Unit]
Description=orca-proxy (unified VM credential-injection & logging proxy)
After=network-online.target

[Service]
# %h/.orca-proxy/current is a symlink to the active versioned install
# (deploy/install.sh) — this path never changes across upgrades, so the unit
# file itself never needs editing (design ticket #12). proxy_addon.py is
# copied to a stable top-level location within each versioned install for
# the same reason (its real location inside site-packages varies by Python
# version). mitmdump itself embeds the Management API on the same process
# via the addon's running()/done() hooks (ticket #4's "same process"
# decision) — this is the entire deployed service, one unit, one process.
ExecStart=%h/.orca-proxy/current/venv/bin/mitmdump --mode transparent --listen-port 8443 --set confdir=%h/.orca-proxy/mitm-confdir -s %h/.orca-proxy/current/proxy_addon.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
